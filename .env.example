# QuantOS environment template.
# Copy to `.env` and fill in locally. `.env` is gitignored; this template must never hold a
# real value.
#
# Credentials are read ONLY from the process environment, by
# `quant_system.data.upstox.UpstoxClient`. There is no config-file credential path and no
# dotenv auto-loading: export these in your shell (or your service manager) before launching.
#
#   PowerShell:  $env:UPSTOX_ACCESS_TOKEN = "<token>"
#   bash:        export UPSTOX_ACCESS_TOKEN="<token>"
#
# With no token configured, governed acquisition returns a non-retryable PROVIDER_UNAUTHORIZED
# outcome and the bundled server and daily pipeline run on SYNTHETIC generated bars.

# Upstox V3 API key. Retained for source compatibility; V3 historical data authenticates with the
# bearer token below, not this value.
UPSTOX_API_KEY=

# Upstox V3 bearer token. Required for any real market-data acquisition.
UPSTOX_ACCESS_TOKEN=
